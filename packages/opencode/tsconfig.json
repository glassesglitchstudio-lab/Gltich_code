{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@tui/*": ["./src/cli/cmd/tui/*"],
      "@test/*": ["./test/*"],
      "@glitchcode/shared/*": ["../shared/src/*"],
      "@glitchcode/shared": ["../shared/src/index.ts"],
      "@glitchcode/sdk/v2": ["../sdk/js/src/v2/index.ts"],
      "@glitchcode/sdk/*": ["../sdk/js/src/*"],
      "@glitchcode/sdk": ["../sdk/js/src/index.ts"],
      "@glitchcode/plugin/*": ["../plugin/src/*"],
      "@glitchcode/plugin": ["../plugin/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "transform": "@effect/language-service/transform",
        "namespaceImportPackages": ["effect", "@effect/*"]
      }
    ]
  }
}
